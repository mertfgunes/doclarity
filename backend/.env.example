DATABASE_URL=postgresql://doclarity:doclarity@localhost:5432/doclarity
# Least-privilege role used only to run LLM-generated SQL (Slice 4 analytics)
# - can SELECT, nothing else. Created by db/init/01_readonly_role.sql.
ANALYTICS_DATABASE_URL=postgresql://doclarity_readonly:doclarity_readonly@localhost:5432/doclarity
REDIS_URL=redis://localhost:6379/0

# LLM_PROVIDER: "ollama" (default, free/local - needs `ollama serve` running) or
# "anthropic" (real quality, billed API key - use for occasional live demos).
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=your-key-here
# EMBEDDING_PROVIDER is separate because Anthropic has no embeddings API -
# Slice 3 (RAG) always needs Ollama for this, even if LLM_PROVIDER=anthropic.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Only needed in prod, where Ollama sits behind deploy/ollama's auth proxy -
# leave blank for local dev (no auth needed against a local Ollama).
OLLAMA_API_KEY=

# Slice 8 auth. Change JWT_SECRET_KEY for any real deployment - this
# default is only safe for local dev.
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

STORAGE_BACKEND=local
UPLOAD_DIR=./uploaded_files
# For STORAGE_BACKEND=s3 (e.g. Cloudflare R2 - set S3_ENDPOINT_URL to your
# R2 account endpoint; leave blank for real AWS S3)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

ENVIRONMENT=development
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000
